---
import type { OtmPost } from '../lib/substack';
interface Props { post: OtmPost; showImage?: boolean }
const { post, showImage = true } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<li class="card">
  {showImage && post.image && <a href={post.link}><img src={post.image} alt="" loading="lazy" /></a>}
  <div class="label">{fmt(post.date)} · {post.author.split(' ')[0]}</div>
  <h3><a href={post.link}>{post.title}</a></h3>
  {post.description && <p>{post.description}</p>}
</li>
